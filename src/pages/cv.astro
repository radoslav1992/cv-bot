---
import App from '../layouts/App.astro';
---
<App title="Моите CV-та — CV Bot" active="cv">
  <div class="head">
    <div>
      <h1 class="display">Моите CV-та</h1>
      <p class="sub">Редактирай директно в документа. Скорът се преизчислява веднага.</p>
    </div>
    <div class="head-actions">
      <button class="btn btn-soft" type="button" data-new>Празно CV</button>
      <a class="btn btn-primary" href="/chat">Ново CV в чат</a>
    </div>
  </div>

  <div class="layout">
    <aside class="side">
      <div class="card">
        <h2 class="card-title" style="margin-bottom:16px">Документи</h2>
        <div class="list" data-list></div>
      </div>
    </aside>

    <section class="main">
      <div class="card toolbar">
        <input class="input name" data-name aria-label="Име на документа" />
        <div class="toolbar-actions">
          <button class="btn btn-soft btn-sm" type="button" data-analyze>Анализирай</button>
          <button class="btn btn-soft btn-sm" type="button" data-letter>Мотивационно писмо</button>
          <button class="btn btn-soft btn-sm" type="button" data-export>Експорт JSON</button>
          <button class="btn btn-primary btn-sm" type="button" data-print>Изтегли PDF</button>
        </div>
      </div>

      <div class="card review" data-review hidden>
        <div class="review-head">
          <h2 class="card-title">Анализ</h2>
          <button class="btn btn-ghost btn-sm" type="button" data-review-close>Затвори</button>
        </div>
        <div class="review-body" data-review-body></div>
      </div>

      <div class="grid">
        <div class="card editor">
          <h2 class="card-title" style="margin-bottom:18px">Редакция</h2>

          <div class="pair">
            <label class="field"><span>Име и фамилия</span><input class="input" data-bind="contact.name" /></label>
            <label class="field"><span>Позиция</span><input class="input" data-bind="contact.title" /></label>
            <label class="field"><span>Град</span><input class="input" data-bind="contact.city" /></label>
            <label class="field"><span>Имейл</span><input class="input" data-bind="contact.email" /></label>
            <label class="field"><span>Телефон</span><input class="input" data-bind="contact.phone" /></label>
            <label class="field"><span>Линкове (през запетая)</span><input class="input" data-bind="contact.links" /></label>
          </div>

          <label class="field block"><span>Обобщение</span><textarea class="textarea" style="min-height:90px" data-bind="summary"></textarea></label>
          <label class="field block"><span>Умения (през запетая)</span><textarea class="textarea" style="min-height:70px" data-bind="skills"></textarea></label>
          <label class="field block"><span>Езици (напр. „Английски — C1“, по един на ред)</span><textarea class="textarea" style="min-height:70px" data-bind="languages"></textarea></label>

          <div class="section-head">
            <h3>Опит</h3>
            <button class="btn btn-ghost btn-sm" type="button" data-add-exp>+ Позиция</button>
          </div>
          <div data-exp-list></div>

          <div class="section-head">
            <h3>Образование</h3>
            <button class="btn btn-ghost btn-sm" type="button" data-add-edu>+ Запис</button>
          </div>
          <div data-edu-list></div>
        </div>

        <div class="stack-right">
          <div class="card-dark score">
            <div class="score-head">
              <h2 class="card-title">ATS скор</h2>
              <span class="score-label" data-score-label>—</span>
            </div>
            <div class="score-big display" data-score-value>—</div>
            <div class="bars" data-bars></div>
          </div>

          <div class="card">
            <h2 class="card-title" style="margin-bottom:16px">Препоръки</h2>
            <div class="findings" data-findings></div>
          </div>

          <div class="card">
            <h2 class="card-title" style="margin-bottom:16px">Преглед</h2>
            <div class="paper" data-doc></div>
          </div>
        </div>
      </div>
    </section>
  </div>

  <div class="toast" data-toast hidden></div>
</App>

<style>
  .head { display: flex; align-items: flex-end; justify-content: space-between; gap: 20px; margin-bottom: 28px; flex-wrap: wrap; }
  h1 { font-size: 42px; letter-spacing: -.02em; margin-bottom: 6px; }
  .sub { font-size: 16px; color: var(--muted-2); }
  .head-actions { display: flex; gap: 10px; }

  .layout { display: grid; grid-template-columns: 260px 1fr; gap: 16px; align-items: start; }
  .list { display: flex; flex-direction: column; gap: 6px; }

  .toolbar { display: flex; align-items: center; gap: 12px; margin-bottom: 16px; flex-wrap: wrap; padding: 16px 20px; }
  .name { flex: 1; min-width: 200px; font-size: 16px; font-weight: 500; }
  .toolbar-actions { display: flex; gap: 8px; flex-wrap: wrap; }

  .review { margin-bottom: 16px; }
  .review-head { display: flex; align-items: center; justify-content: space-between; margin-bottom: 14px; }
  .review-body { font-size: 15px; line-height: 1.7; color: var(--ink-2); white-space: pre-line; }

  .grid { display: grid; grid-template-columns: 1.1fr .9fr; gap: 16px; align-items: start; }
  .pair { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; margin-bottom: 14px; }
  .field.block { margin-bottom: 14px; }
  .section-head { display: flex; align-items: center; justify-content: space-between; margin: 22px 0 12px; }
  .section-head h3 { font-size: 15px; font-weight: 500; }

  .stack-right { display: flex; flex-direction: column; gap: 16px; }
  .score-head { display: flex; align-items: center; justify-content: space-between; }
  .score-label { font-size: 13px; color: var(--green-soft-2); }
  .score-big { font-size: 56px; line-height: 1; margin: 10px 0 18px; }
  .bars { display: flex; flex-direction: column; gap: 12px; font-size: 14px; }
  .findings { display: flex; flex-direction: column; gap: 8px; }
  .paper {
    background: var(--paper);
    border: 1px solid var(--line);
    border-radius: var(--r-md);
    padding: 24px 22px;
    box-shadow: var(--shadow-paper);
  }

  .toast {
    position: fixed; bottom: 24px; left: 50%; transform: translateX(-50%);
    background: var(--green); color: var(--on-green);
    padding: 12px 20px; border-radius: var(--r-md); font-size: 14px; z-index: 95;
    box-shadow: var(--shadow-card); max-width: 90vw;
  }

  @media (max-width: 1200px) { .grid { grid-template-columns: 1fr; } }
  @media (max-width: 900px) { .layout { grid-template-columns: 1fr; } .pair { grid-template-columns: 1fr; } h1 { font-size: 32px; } }
</style>

<style is:global>
  .doc-item {
    text-align: left;
    padding: 12px 14px;
    border-radius: var(--r-md);
    border: 1px solid var(--line-2);
    background: var(--surface);
    cursor: pointer;
    font-family: var(--font-body);
    display: block;
    width: 100%;
  }
  .doc-item:hover { border-color: var(--green); }
  .doc-item.current { border-color: var(--green); background: var(--tint-green); }
  .doc-item-name { font-size: 14px; font-weight: 500; margin-bottom: 3px; }
  .doc-item-meta { font-size: 12px; color: var(--muted-3); }

  .exp-card, .edu-card {
    border: 1px solid var(--line-2);
    border-radius: var(--r-md);
    padding: 14px;
    margin-bottom: 10px;
    background: var(--bg);
  }
  .exp-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 10px; margin-bottom: 10px; }
  .exp-head { display: flex; justify-content: flex-end; }
  .remove {
    background: none; border: none; color: var(--accent); cursor: pointer;
    font-size: 13px; font-family: var(--font-body); padding: 0;
  }
  @media (max-width: 700px) { .exp-grid { grid-template-columns: 1fr; } }
</style>

<script src="../scripts/cv.ts"></script>
