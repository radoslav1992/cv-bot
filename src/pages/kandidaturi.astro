---
import App from '../layouts/App.astro';
import { STATUS_LABELS } from '../lib/cv';

const columns = ['draft', 'sent', 'waiting', 'interview', 'offer', 'rejected'] as const;
---
<App title="Кандидатури — CV Bot" active="kandidaturi">
  <div class="head">
    <div>
      <h1 class="display">Кандидатури</h1>
      <p class="sub">Едно място за всяка изпратена молба и за версията на CV-то към нея.</p>
    </div>
  </div>

  <form class="card add" data-add>
    <label class="field"><span>Компания</span><input class="input" name="company" placeholder="Progress" required /></label>
    <label class="field"><span>Позиция</span><input class="input" name="position" placeholder="Senior Frontend Developer" required /></label>
    <label class="field">
      <span>Статус</span>
      <select class="select" name="status">
        {columns.map((key) => <option value={key}>{STATUS_LABELS[key]}</option>)}
      </select>
    </label>
    <button class="btn btn-primary" type="submit">Добави</button>
  </form>

  <div class="board" data-board>
    {columns.map((key) => (
      <div class="column">
        <div class="column-head">
          <span>{STATUS_LABELS[key]}</span>
          <span class="tally" data-tally={key}>0</span>
        </div>
        <div class="column-body" data-column={key}></div>
      </div>
    ))}
  </div>
</App>

<style>
  .head { margin-bottom: 24px; }
  h1 { font-size: 42px; letter-spacing: -.02em; margin-bottom: 6px; }
  .sub { font-size: 16px; color: var(--muted-2); }

  .add {
    display: grid;
    grid-template-columns: 1fr 1fr 200px auto;
    gap: 12px;
    align-items: end;
    margin-bottom: 20px;
    padding: 20px;
  }
  .add .btn { padding: 13px 22px; }

  .board { display: grid; grid-template-columns: repeat(3, 1fr); gap: 16px; }
  .column { background: var(--surface); border: 1px solid var(--line); border-radius: var(--r-lg); padding: 18px; }
  .column-head { display: flex; justify-content: space-between; align-items: center; font-size: 14px; font-weight: 500; margin-bottom: 14px; }
  .tally { font-family: var(--font-display); font-size: 20px; color: var(--muted-3); }
  .column-body { display: flex; flex-direction: column; gap: 8px; min-height: 40px; }

  @media (max-width: 1100px) { .board { grid-template-columns: 1fr 1fr; } .add { grid-template-columns: 1fr 1fr; } }
  @media (max-width: 700px) { .board, .add { grid-template-columns: 1fr; } h1 { font-size: 32px; } }
</style>

<style is:global>
  .app-card { border: 1px solid var(--line-2); border-radius: var(--r-md); padding: 12px 14px; background: var(--bg); }
  .app-card-company { font-size: 14px; font-weight: 500; }
  .app-card-position { font-size: 13px; color: var(--muted-3); margin-bottom: 8px; }
  .app-card-foot { display: flex; align-items: center; justify-content: space-between; gap: 8px; }
  .app-card select { font-family: var(--font-body); font-size: 12px; padding: 5px 8px; border-radius: 8px; border: 1px solid var(--line-3); background: var(--surface); color: var(--muted); }
  .app-card .remove { background: none; border: none; color: var(--accent); cursor: pointer; font-size: 12px; font-family: var(--font-body); }
  .column-empty { font-size: 13px; color: var(--muted-4); }
</style>

<script src="../scripts/applications.ts"></script>
