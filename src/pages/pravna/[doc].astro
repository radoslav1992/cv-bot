---
import Marketing from '../../layouts/Marketing.astro';
import { LEGAL_DOCS, findLegalDoc } from '../../lib/legal';

export const prerender = true;

export function getStaticPaths() {
  return LEGAL_DOCS.map((doc) => ({ params: { doc: doc.slug } }));
}

const doc = findLegalDoc(Astro.params.doc)!;
---
<Marketing title={`${doc.title} — CV Bot`} description={doc.intro}>
  <main class="shell page">
    <nav aria-label="Правни документи">
      <div class="eyebrow">Правна информация</div>
      {LEGAL_DOCS.map((item) => (
        <a href={`/pravna/${item.slug}`} class:list={['nav-item', { current: item.slug === doc.slug }]}>{item.navLabel}</a>
      ))}
    </nav>

    <article>
      <div class="updated">Последна актуализация: {doc.updated}</div>
      <h1 class="display">{doc.title}</h1>
      <p class="intro">{doc.intro}</p>
      <div class="sections">
        {doc.sections.map((section) => (
          <section>
            <h2>{section.h}</h2>
            <p>{section.p}</p>
          </section>
        ))}
      </div>
      <div class="contact">
        Въпроси по този документ: <a href="mailto:legal@cvbot.bg">legal@cvbot.bg</a>. Отговаряме в рамките на
        14 дни, а при заявки по GDPR — в рамките на 30 дни.
      </div>
    </article>
  </main>
</Marketing>

<style>
  .page {
    padding: 64px 32px 96px;
    display: grid;
    grid-template-columns: 240px 1fr;
    gap: 64px;
  }
  nav {
    font-size: 15px;
    position: sticky;
    top: 100px;
    align-self: start;
    display: flex;
    flex-direction: column;
    gap: 2px;
  }
  nav .eyebrow { margin-bottom: 12px; }
  .nav-item { padding: 10px 12px; border-radius: 10px; color: var(--muted); }
  .nav-item:hover { background: var(--chip); color: var(--green); }
  .nav-item.current { color: var(--green); font-weight: 500; }

  article { max-width: 720px; }
  .updated { font-size: 14px; color: var(--muted-3); margin-bottom: 12px; }
  h1 { font-size: 52px; line-height: 1.05; letter-spacing: -.025em; margin-bottom: 20px; }
  .intro { font-size: 18px; line-height: 1.7; color: var(--muted); margin-bottom: 44px; text-wrap: pretty; }
  .sections { display: flex; flex-direction: column; gap: 36px; }
  .sections h2 { font-size: 22px; font-weight: 500; margin-bottom: 12px; letter-spacing: -.01em; }
  .sections p { font-size: 16px; line-height: 1.75; color: var(--ink-3); text-wrap: pretty; }
  .contact {
    margin-top: 56px;
    padding: 24px;
    background: var(--bg-2);
    border-radius: 16px;
    font-size: 15px;
    line-height: 1.7;
    color: var(--muted);
  }
  .contact a { color: var(--accent); }

  @media (max-width: 900px) {
    .page { grid-template-columns: 1fr; gap: 32px; padding-top: 40px; }
    nav { position: static; flex-direction: row; flex-wrap: wrap; gap: 6px; }
    nav .eyebrow { width: 100%; margin-bottom: 4px; }
    .nav-item { border: 1px solid var(--line); }
    h1 { font-size: 36px; }
  }
</style>
